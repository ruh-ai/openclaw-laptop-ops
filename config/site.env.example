# =============================================================================
# site.env — the ONE file that describes this laptop. Copy to config/site.env,
# fill in during RUNBOOK Phase 0 (discovery). Read by every script in windows/
# and wsl/. KEY=VALUE, no quotes needed unless the value has spaces.
# config/site.env is gitignored. Never put secrets here (see SECRETS below).
# =============================================================================

# ---- Identity ---------------------------------------------------------------
SITE_NAME=client-laptop-01                 # short name used in Slack messages / logs
WIN_USER=                                  # Windows account that OWNS the WSL distro (whoami). Tasks run as this user.
DISTRO=Ubuntu-24.04                        # `wsl -l -v` name, exactly
WSL_USER=openclaw                          # non-root Linux user that runs the gateway + repair runner
WSL_HOME=/home/openclaw

# ---- OpenClaw ---------------------------------------------------------------
GATEWAY_PORT=18789
OPENCLAW_HOME=/home/openclaw/.openclaw     # config dir (openclaw.json, .env)
OPENCLAW_SERVICE=openclaw-gateway.service  # systemd --user unit created by `openclaw gateway install`
OPS_OPENCLAW_INSTALL=installer          # installer | npm | existing   (existing = already installed, don't touch)

# ---- Tailscale (Windows only — NEVER install tailscale inside WSL) ----------
TS_HOSTNAME=openclaw-laptop                # device name in the tailnet
TS_TAILNET=                                # e.g. tail1a2b3.ts.net  (from `tailscale status --json` .MagicDNSSuffix)
TS_TAGS=tag:openclaw-laptop                # tags applied via auth key (key expiry disabled for tagged devices)
TS_SERVE_HTTPS_PORT=443
# Derived on-site: TS_URL=https://${TS_HOSTNAME}.${TS_TAILNET}

# ---- Windows SSH ------------------------------------------------------------
SSH_PORT=22
SSH_GROUP=openclaw-operators               # local Windows group allowed to SSH
SSH_TAILNET_CIDR=100.64.0.0/10             # firewall scope: Tailscale CGNAT range only
# Operator public keys live in config/operators/<name>.pub (committed — they are public keys)

# ---- Paths on Windows (created by scripts, ACL-restricted to WIN_USER+SYSTEM+Administrators)
REPO_DIR_WIN=C:\openclaw-laptop-ops
OPS_ROOT_WIN=C:\ProgramData\openclaw-ops   # state.json, logs\, secrets\, backups\, snapshots\, reports\
# WSL sees the repo at /mnt/c/openclaw-laptop-ops (derived from REPO_DIR_WIN)

# ---- Supervisor / recovery staging -----------------------------------------
# observe  = health checks + Slack only, NO recovery actions        (TONIGHT)
# restart  = + restart gateway / restart WSL / rollback config      (after 24h clean observe)
# repair   = + AI repair runner                                     (after restart mode proven)
RECOVERY_MODE=observe
SUPERVISOR_INTERVAL_MIN=1
CONFIRM_FAILURES=2                         # consecutive failed cycles before acting
STABILIZATION_CYCLES=3                     # consecutive healthy cycles to declare recovered
MAX_AI_REPAIRS_PER_HOUR=3
AI_COOLDOWN_MIN=60
DISK_WARN_PCT=85                           # % used on C: and WSL root that triggers a warning + blocks backups/repair
HEARTBEAT_GAP_ALERT_MIN=5                  # after boot: report availability gap if last heartbeat older than this

# ---- WSL VM keep-alive -------------------------------------------------------
# WSL >= 2.6 terminates an idle VM. systemd + gateway keep it busy, but set a long idle timeout anyway.
WSL_VM_IDLE_TIMEOUT_MS=3600000
WSL_MEMORY=                                # e.g. 4GB ; blank = WSL default (50% RAM)

# ---- AI repair runner --------------------------------------------------------
AI_PRIMARY=codex                           # codex | claude
AI_SECONDARY=claude                        # codex | claude | none
AI_AUTH_MODE=subscription                  # subscription (logged-in CLI) | apikey (OPENAI_API_KEY / ANTHROPIC_API_KEY in ${OPENCLAW_HOME}/../.openclaw-ops/ai.env)
CODEX_MODEL=                               # blank = CLI default
CLAUDE_MODEL=                              # blank = CLI default
AI_REPAIR_TIMEOUT_MIN=20

# ---- Backups -----------------------------------------------------------------
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_NIGHTLY_TIME=02:30
WSL_EXPORT_DAY=Sunday
WSL_EXPORT_TIME=03:30
MIN_FREE_GB_FOR_EXPORT=15

# ---- Power -------------------------------------------------------------------
DISABLE_SLEEP_ON_AC=true
LID_CLOSE_DOES_NOTHING_ON_AC=true

# =============================================================================
# SECRETS — where they live (never in this file, never in git):
#   Slack webhook      -> %OPS_ROOT_WIN%\secrets\slack.xml   (DPAPI, set by windows\secrets\Set-OpsSecret.ps1 -Name slack)
#   Gateway token      -> ${OPENCLAW_HOME}/.env  OPENCLAW_GATEWAY_TOKEN=...   (chmod 600, WSL_USER only)
#   Tailscale auth key -> typed live into windows\10-tailscale.ps1 prompt; never stored
#   AI API keys        -> /home/${WSL_USER}/.openclaw-ops/ai.env (chmod 600) only if AI_AUTH_MODE=apikey
#   GitHub clone PAT   -> typed live at clone; remote URL is rewritten to strip it afterwards
# =============================================================================
